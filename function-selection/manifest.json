{
  "container": "assistos/local-llms:latest",
  "about": "Function routing with FunctionGemma — specialized tool/function selection",
  "start": "/opt/local-llms/scripts/start-agent.sh",
  "cli": "/bin/bash",
  "readiness": {
    "protocol": "mcp"
  },
  "health": {
    "readiness": {
      "script": "healthcheck.sh",
      "interval": 10,
      "timeout": 15,
      "failureThreshold": 18
    }
  },
  "volumes": {
    ".ploinky/data/local-llms": "/data/local-llms"
  },
  "profiles": {
    "default": {
      "ports": [
        "127.0.0.1:17030:7000",
        "127.0.0.1:18434:11434"
      ],
      "env": [
        {
          "name": "LOCAL_LLMS_AGENT_ID",
          "required": false,
          "default": "function-selection"
        },
        {
          "name": "LOCAL_LLMS_DEFAULT_MODEL",
          "required": false,
          "default": "functiongemma"
        },
        {
          "name": "LOCAL_LLMS_BACKEND",
          "required": false,
          "default": "ollama"
        },
        {
          "name": "LOCAL_LLMS_BACKEND_PORT",
          "required": false,
          "default": "11434"
        },
        {
          "name": "OLLAMA_HOST",
          "required": false,
          "default": "0.0.0.0:11434"
        },
        {
          "name": "OLLAMA_MODELS",
          "required": false,
          "default": "/data/local-llms/ollama/models"
        },
        {
          "name": "OLLAMA_NUM_PARALLEL",
          "required": false,
          "default": "1"
        },
        {
          "name": "OLLAMA_MAX_LOADED_MODELS",
          "required": false,
          "default": "1"
        },
        {
          "name": "OLLAMA_KEEP_ALIVE",
          "required": false,
          "default": "5m"
        },
        {
          "name": "LOCAL_LLMS_DATA_DIR",
          "required": false,
          "default": "/data/local-llms"
        },
        {
          "name": "LOCAL_LLMS_CATALOG_DIR",
          "required": false,
          "default": "/opt/local-llms/catalog"
        }
      ]
    }
  }
}
