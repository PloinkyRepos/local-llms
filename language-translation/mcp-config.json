{
  "tools": [
    {
      "name": "list_available_models",
      "title": "List Available Models",
      "description": "List translation models available for this agent.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "backendFilter": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "list_available_models"
      }
    },
    {
      "name": "start_model",
      "title": "Start Model",
      "description": "Start the specified translation model on this agent's backend.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "start_model"
      }
    },
    {
      "name": "stop_model",
      "title": "Stop Model",
      "description": "Stop the currently running translation model.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "stop_model"
      }
    },
    {
      "name": "status_model",
      "title": "Model Status",
      "description": "Check the status of the translation model backend.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "status_model"
      }
    },
    {
      "name": "translate",
      "title": "Translate Text",
      "description": "Translate text between languages using the active translation model.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "text": {
          "type": "string",
          "optional": false
        },
        "sourceLang": {
          "type": "string",
          "optional": true
        },
        "targetLang": {
          "type": "string",
          "optional": false
        }
      },
      "env": {
        "TOOL_NAME": "translate"
      }
    }
  ]
}
