{
  "tools": [
    {
      "name": "list_available_models",
      "title": "List Available Models",
      "description": "List reranker models available for this agent.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "backendFilter": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "list_available_models"
      }
    },
    {
      "name": "start_model",
      "title": "Start Model",
      "description": "Start the specified reranker model on this agent's backend.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "start_model"
      }
    },
    {
      "name": "stop_model",
      "title": "Stop Model",
      "description": "Stop the currently running reranker model.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "stop_model"
      }
    },
    {
      "name": "status_model",
      "title": "Model Status",
      "description": "Check the status of the reranker model backend.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "status_model"
      }
    },
    {
      "name": "rerank",
      "title": "Rerank Passages",
      "description": "Score and rerank passages against a query using the active reranker model.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "query": {
          "type": "string",
          "optional": false
        },
        "passages": {
          "type": "array",
          "optional": false,
          "items": {
            "type": "string"
          }
        },
        "topK": {
          "type": "number",
          "optional": true
        },
        "instruction": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "rerank"
      }
    }
  ]
}
