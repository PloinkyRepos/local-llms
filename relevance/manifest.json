{
  "container": "assistos/local-llms:latest",
  "about": "Cross-encoder reranker for passage relevance scoring — Qwen3-Reranker-0.6B",
  "start": "/opt/local-llms/scripts/start-agent.sh",
  "cli": "/bin/bash",
  "readiness": {
    "protocol": "mcp"
  },
  "health": {
    "readiness": {
      "script": "healthcheck.sh",
      "interval": 10,
      "timeout": 15,
      "failureThreshold": 12
    }
  },
  "volumes": {
    ".ploinky/data/local-llms": "/data/local-llms"
  },
  "profiles": {
    "default": {
      "ports": [
        "127.0.0.1:17020:7000",
        "127.0.0.1:18091:8091"
      ],
      "env": [
        {
          "name": "LOCAL_LLMS_AGENT_ID",
          "required": false,
          "default": "relevance"
        },
        {
          "name": "LOCAL_LLMS_DEFAULT_MODEL",
          "required": false,
          "default": "Qwen/Qwen3-Reranker-0.6B"
        },
        {
          "name": "LOCAL_LLMS_BACKEND",
          "required": false,
          "default": "reranker"
        },
        {
          "name": "LOCAL_LLMS_BACKEND_PORT",
          "required": false,
          "default": "8091"
        },
        {
          "name": "LOCAL_LLMS_DATA_DIR",
          "required": false,
          "default": "/data/local-llms"
        },
        {
          "name": "LOCAL_LLMS_CATALOG_DIR",
          "required": false,
          "default": "/opt/local-llms/catalog"
        }
      ]
    }
  }
}
