{
  "tools": [
    {
      "name": "list_available_models",
      "title": "List Available Models",
      "description": "List models available for this agent from catalog and workspace registry.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "backendFilter": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "list_available_models"
      }
    },
    {
      "name": "start_model",
      "title": "Start Model",
      "description": "Start or switch to the specified model on this agent's backend.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "start_model"
      }
    },
    {
      "name": "stop_model",
      "title": "Stop Model",
      "description": "Stop the currently running model on this agent's backend.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "stop_model"
      }
    },
    {
      "name": "status_model",
      "title": "Model Status",
      "description": "Check the status of the model backend and currently loaded model.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "status_model"
      }
    },
    {
      "name": "register_model",
      "title": "Register Model",
      "description": "Register a new model for this agent in the workspace registry.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": false
        },
        "backend": {
          "type": "string",
          "optional": true
        },
        "parameters": {
          "type": "object",
          "optional": true,
          "additionalProperties": true
        }
      },
      "env": {
        "TOOL_NAME": "register_model"
      }
    }
  ]
}
