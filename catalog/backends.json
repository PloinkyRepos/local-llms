{
  "backends": {
    "ollama": {
      "name": "Ollama",
      "description": "Ollama model server for GGUF and safetensors models with OpenAI-compatible API",
      "internalPort": 11434,
      "apiShape": "openai-chat",
      "readinessProbe": {
        "type": "http",
        "path": "/api/tags",
        "expectedStatus": 200
      },
      "storagePath": "/data/local-llms/ollama/models",
      "hostStorageKey": "ollama/models",
      "runner": "scripts/runners/ollama.sh",
      "pullCommand": "ollama pull",
      "experimental": false
    },
    "llama_cpp": {
      "name": "llama.cpp server",
      "description": "llama.cpp HTTP server for GGUF models with OpenAI-compatible completions",
      "internalPort": 8080,
      "apiShape": "openai-chat",
      "readinessProbe": {
        "type": "http",
        "path": "/health",
        "expectedStatus": 200
      },
      "storagePath": "/data/local-llms/llama-cpp/models",
      "hostStorageKey": "llama-cpp/models",
      "runner": "scripts/runners/llama-cpp.sh",
      "pullCommand": null,
      "experimental": false
    },
    "transformers_seq2seq": {
      "name": "Transformers Seq2Seq",
      "description": "HuggingFace transformers encoder-decoder models served via lightweight Python HTTP service",
      "internalPort": 8090,
      "apiShape": "translation",
      "readinessProbe": {
        "type": "http",
        "path": "/health",
        "expectedStatus": 200
      },
      "storagePath": "/data/local-llms/transformers/cache",
      "hostStorageKey": "transformers/cache",
      "runner": "scripts/runners/transformers-seq2seq.sh",
      "pullCommand": null,
      "experimental": false
    },
    "reranker": {
      "name": "Reranker/Scoring API",
      "description": "Cross-encoder or sentence-transformers scoring service via Python HTTP",
      "internalPort": 8091,
      "apiShape": "scoring",
      "readinessProbe": {
        "type": "http",
        "path": "/health",
        "expectedStatus": 200
      },
      "storagePath": "/data/local-llms/transformers/cache",
      "hostStorageKey": "transformers/cache",
      "runner": "scripts/runners/reranker.sh",
      "pullCommand": null,
      "experimental": false
    },
    "vllm": {
      "name": "vLLM",
      "description": "vLLM OpenAI-compatible server for HuggingFace causal/chat models",
      "internalPort": 8000,
      "apiShape": "openai-chat",
      "readinessProbe": {
        "type": "http",
        "path": "/health",
        "expectedStatus": 200
      },
      "storagePath": "/data/local-llms/vllm/cache",
      "hostStorageKey": "vllm/cache",
      "runner": "scripts/runners/vllm.sh",
      "pullCommand": null,
      "experimental": true,
      "notes": "Requires GPU and CUDA; image size is large. Install as a profile-driven runner."
    },
    "sglang": {
      "name": "SGLang",
      "description": "SGLang OpenAI-compatible server for HuggingFace models",
      "internalPort": 8001,
      "apiShape": "openai-chat",
      "readinessProbe": {
        "type": "http",
        "path": "/health",
        "expectedStatus": 200
      },
      "storagePath": "/data/local-llms/sglang/cache",
      "hostStorageKey": "sglang/cache",
      "runner": "scripts/runners/sglang.sh",
      "pullCommand": null,
      "experimental": true,
      "notes": "Requires GPU and CUDA; install as a profile-driven runner."
    },
    "lmstudio_llmster": {
      "name": "LM Studio llmster",
      "description": "LM Studio headless daemon (experimental)",
      "internalPort": 1234,
      "apiShape": "openai-chat",
      "readinessProbe": {
        "type": "http",
        "path": "/v1/models",
        "expectedStatus": 200
      },
      "storagePath": "/data/local-llms/lmstudio/models",
      "hostStorageKey": "lmstudio/models",
      "runner": "scripts/runners/lmstudio-llmster.sh",
      "pullCommand": null,
      "experimental": true,
      "notes": "LM Studio llmster is a preview headless daemon. Not a default v1 dependency. Requires separate Docker image or host install verification."
    }
  }
}
