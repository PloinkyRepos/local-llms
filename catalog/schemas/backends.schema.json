{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backends.schema.json",
  "title": "Local LLMs Backend Definitions",
  "type": "object",
  "required": ["backends"],
  "additionalProperties": false,
  "properties": {
    "backends": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/backendEntry"
      }
    }
  },
  "$defs": {
    "backendEntry": {
      "type": "object",
      "required": ["name", "description", "internalPort", "apiShape", "readinessProbe", "storagePath", "hostStorageKey", "runner"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "internalPort": { "type": "integer", "minimum": 1 },
        "apiShape": { "type": "string", "enum": ["openai-chat", "translation", "scoring"] },
        "readinessProbe": {
          "type": "object",
          "required": ["type", "path", "expectedStatus"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["http", "tcp"] },
            "path": { "type": "string" },
            "expectedStatus": { "type": "integer" }
          }
        },
        "storagePath": { "type": "string" },
        "hostStorageKey": { "type": "string" },
        "runner": { "type": "string" },
        "pullCommand": { "type": ["string", "null"] },
        "experimental": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
