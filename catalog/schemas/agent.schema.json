{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent.schema.json",
  "title": "Local LLMs Agent Catalog Entry",
  "type": "object",
  "required": ["agentId", "description", "models", "defaultModel", "backend", "taskApi", "ramBand", "gpuRequired", "cpuSafe", "defaultEnabled", "readinessTimeout", "startupPreset"],
  "additionalProperties": false,
  "properties": {
    "agentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string" },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelEntry"
      }
    },
    "defaultModel": { "type": "string" },
    "backend": { "type": "string" },
    "taskApi": { "type": "string", "enum": ["chat", "function-calling", "translation", "scoring", "management"] },
    "ramBand": { "type": "string" },
    "gpuRequired": { "type": "boolean" },
    "recommendedVram": { "type": ["string", "null"] },
    "cpuSafe": { "type": "boolean" },
    "defaultEnabled": { "type": "boolean" },
    "readinessTimeout": { "type": "integer", "minimum": 1 },
    "startupPreset": { "type": "string" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "modelEntry": {
      "type": "object",
      "required": ["name", "backend", "taskApi"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "backendModel": { "type": ["string", "null"] },
        "backend": { "type": "string" },
        "taskApi": { "type": "string" },
        "huggingfaceId": { "type": ["string", "null"] },
        "ollamaMinVersion": { "type": ["string", "null"] },
        "quantization": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    }
  }
}
