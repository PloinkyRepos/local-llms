{
  "container": "assistos/local-llms:latest",
  "about": "Local LLM management agent — model registration, startup script generation, and agent profile lifecycle",
  "start": "/opt/local-llms/scripts/start-agent.sh",
  "cli": "/bin/bash",
  "enable": [
    "function-selection global no-wait",
    "function-invocation global no-wait"
  ],
  "volumes": {
    ".ploinky/data/local-llms": "/data/local-llms"
  },
  "profiles": {
    "default": {
      "ports": [
        "127.0.0.1:17000:7000"
      ],
      "env": [
        {
          "name": "LOCAL_LLMS_AGENT_ID",
          "required": false,
          "default": "local-llms-manager"
        },
        {
          "name": "LOCAL_LLMS_DATA_DIR",
          "required": false,
          "default": "/data/local-llms"
        },
        {
          "name": "LOCAL_LLMS_CATALOG_DIR",
          "required": false,
          "default": "/opt/local-llms/catalog"
        }
      ]
    }
  }
}
