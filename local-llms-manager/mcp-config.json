{
  "tools": [
    {
      "name": "list_available_models",
      "title": "List Available Models",
      "description": "List all models from the catalog and workspace registry, with backend and status metadata.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "agentFilter": {
          "type": "string",
          "optional": true
        },
        "backendFilter": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "list_available_models"
      }
    },
    {
      "name": "register_model",
      "title": "Register Model",
      "description": "Register a new model in the workspace registry with backend, parameters, and agent assignment.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": false
        },
        "backend": {
          "type": "string",
          "optional": false
        },
        "agentId": {
          "type": "string",
          "optional": false
        },
        "taskApi": {
          "type": "string",
          "optional": true
        },
        "parameters": {
          "type": "object",
          "optional": true,
          "additionalProperties": true
        }
      },
      "env": {
        "TOOL_NAME": "register_model"
      }
    },
    {
      "name": "generate_startup_script",
      "title": "Generate Startup Script",
      "description": "Generate a startup script for a model profile under .ploinky/data/local-llms/scripts/.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "profileId": {
          "type": "string",
          "optional": false
        },
        "agentId": {
          "type": "string",
          "optional": false
        },
        "modelName": {
          "type": "string",
          "optional": false
        },
        "backend": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "generate_startup_script"
      }
    },
    {
      "name": "register_agent_profile",
      "title": "Register Agent Profile",
      "description": "Register a runtime agent profile in the workspace registry. Profiles are logical until promoted.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "profileId": {
          "type": "string",
          "optional": false
        },
        "agentId": {
          "type": "string",
          "optional": false
        },
        "models": {
          "type": "array",
          "optional": false,
          "items": {
            "type": "string"
          }
        },
        "defaultModel": {
          "type": "string",
          "optional": false
        },
        "backend": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "register_agent_profile"
      }
    },
    {
      "name": "promote_agent_profile",
      "title": "Promote Agent Profile",
      "description": "Promote a runtime profile to a first-class agent directory. Development operation only — requires Ploinky restart.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "profileId": {
          "type": "string",
          "optional": false
        }
      },
      "env": {
        "TOOL_NAME": "promote_agent_profile"
      }
    },
    {
      "name": "status_model",
      "title": "Model Status",
      "description": "Check the status of a specific model or all running models across agents.",
      "command": "/opt/local-llms/scripts/dispatcher.sh",
      "cwd": "workspace",
      "inputSchema": {
        "modelName": {
          "type": "string",
          "optional": true
        },
        "agentId": {
          "type": "string",
          "optional": true
        }
      },
      "env": {
        "TOOL_NAME": "status_model"
      }
    }
  ]
}
